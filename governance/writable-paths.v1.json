    },
    {
      "operationKind": "public_opening_hours_replace",
      "permitted": false,
      "comment": "The site publishes no structured opening-hours record (visits are by appointment). Manufacturing one is a content decision for the Consulate, not a policy entry."
    },
    {
      "operationKind": "article_publish",
      "permitted": false,
      "comment": "src/content/insights/*.md requires a PDF, page count and hero image per record — media-bearing by construction. Authored insights need a media-admission contract first."
    }
