{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.consulatetimorleste.co.nz/governance/schemas/site.v1.schema.json",
  "title": "Honorary Consulate governed site record",
  "description": "Platform-facing mirror of src/data/schema.ts. Unknown keys fail. rows[0] is the governed Mobile row (tel: href), rows[1] the governed Email row (mailto: href equal to its value).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand",
    "contact",
    "address",
    "embassy",
    "footer"
  ],
  "properties": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shortName",
        "region",
        "areaServed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "areaServed": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "heading",
        "intro",
        "rows",
        "visitNote",
        "jurisdiction"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value",
                    "href"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    }
                  }
                },
                {
                  "properties": {
                    "label": {
                      "const": "Mobile"
                    },
                    "href": {
                      "pattern": "^tel:\\+[1-9][0-9]{6,14}$"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value",
                    "href"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:.*\\S)?$"
                    }
                  }
                },
                {
                  "properties": {
                    "label": {
                      "const": "Email"
                    },
                    "href": {
                      "pattern": "^mailto:"
                    }
                  }
                }
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value",
                "href"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:.*\\S)?$"
                },
                "href": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:.*\\S)?$"
                }
              }
            }
          ]
        },
        "visitNote": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "jurisdiction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "heading",
            "body"
          ],
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streetAddress",
        "addressLocality",
        "addressRegion",
        "addressCountry",
        "footerLine"
      ],
      "properties": {
        "streetAddress": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "addressLocality": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "addressRegion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "addressCountry": {
          "const": "NZ"
        },
        "footerLine": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "embassy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "heading",
        "body",
        "referralBody",
        "footerBody",
        "phone",
        "email"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "referralBody": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "footerBody": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "phone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "href"
          ],
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "href": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "href"
          ],
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "href": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "region",
        "contactHeading",
        "embassyHeading",
        "coordinates",
        "copyrightHolder"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "contactHeading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "embassyHeading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          }
        },
        "copyrightHolder": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    }
  }
}
