{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.consulatetimorleste.co.nz/governance/schemas/sections.v1.schema.json",
  "title": "Honorary Consulate governed section records",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "eyebrow",
      "title"
    ],
    "properties": {
      "eyebrow": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "lede": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "facts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icon",
            "title",
            "text"
          ],
          "properties": {
            "icon": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      },
      "timeline": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "title",
            "text"
          ],
          "properties": {
            "date": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      },
      "stats": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "caption"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "asAt": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      },
      "services": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icon",
            "title",
            "text"
          ],
          "properties": {
            "icon": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      },
      "profileHeading": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      },
      "profile": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "term",
            "detail"
          ],
          "properties": {
            "term": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:.*\\S)?$"
            }
          }
        }
      }
    }
  },
  "propertyNames": {
    "pattern": "^[a-z0-9-]+$"
  }
}
