---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../lib/content";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  ogType = "website",
  image,
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  title === "Home"
    ? "Honorary Consulate of Timor-Leste · Auckland & North Island"
    : `${title} · Honorary Consulate of Timor-Leste`;

// Structured data renders from the governed record: the phone and email here are the SAME
// values as the contact section and footer, so one governed change updates every occurrence.
const [phoneRow, emailRow] = site.contact.rows;
const governmentOffice = {
  "@context": "https://schema.org",
  "@type": "GovernmentOffice",
  name: site.brand.name,
  areaServed: site.brand.areaServed,
  telephone: phoneRow.value,
  email: emailRow.value,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  url: canonical.origin,
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#12141C" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Honorary Consulate of Timor-Leste" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/timor-leste-flag.png" type="image/png" />
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(governmentOffice)}
    />
    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
