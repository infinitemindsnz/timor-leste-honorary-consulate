---
import { site } from "../lib/content";

// Every public fact below renders from the governed record in src/data/site.yaml.
const { footer, contact, address, embassy } = site;
const [phone, email] = contact.rows;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__accent" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <div class="footer-identity">
      <p class="footer-eyebrow">{footer.eyebrow}</p>
      <p class="footer-title">{footer.title}</p>
      <p>{footer.region}</p>
    </div>

    <div class="footer-contact">
      <h2>{footer.contactHeading}</h2>
      <a href={phone.href}>{phone.value}</a>
      <a href={email.href}>{email.value}</a>
      <p>{address.footerLine}</p>
    </div>

    <div class="footer-embassy">
      <h2>{footer.embassyHeading}</h2>
      <p>{embassy.footerBody}</p>
      <a href={embassy.phone.href}>{embassy.phone.display}</a>
      <a href={embassy.email.href}>{embassy.email.display}</a>
    </div>

    <div class="footer-coordinates" aria-label="Dili and Auckland coordinates">
      {footer.coordinates.map((coordinate) => <span>{coordinate}</span>)}
    </div>

    <div class="footer-legal">
      <!-- TODO(verify): confirm the intended copyright year with the Consulate. -->
      <p>© {year} {footer.copyrightHolder}</p>
      <div class="footer-credit" aria-label="Powered by Infinite Minds AI">
        <span>Powered by</span>
        <img
          src="/images/infinite-minds-ai.png"
          width="1536"
          height="1024"
          alt="Infinite Minds AI"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--undyed);
  }

  .site-footer__accent {
    height: 0.2rem;
    background: var(--turmeric);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    gap: var(--space-5);
    width: min(100% - (2 * var(--page-gutter)), var(--content-wide));
    margin-inline: auto;
    padding-block: var(--space-7) var(--space-4);
  }

  .footer-identity,
  .footer-contact,
  .footer-embassy {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .footer-identity p,
  .footer-contact p,
  .footer-embassy p,
  .footer-legal p {
    margin: 0;
  }

  .footer-eyebrow,
  .footer-coordinates,
  .footer-legal {
    font-family: var(--font-utility);
    font-size: var(--text--2);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .footer-eyebrow {
    color: var(--turmeric);
  }

  .footer-title {
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: var(--text-3);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 0.98;
  }

  .site-footer h2 {
    margin: 0 0 var(--space-1);
    color: var(--turmeric);
    font-family: var(--font-utility);
    font-size: var(--text--1);
    font-weight: 400;
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .site-footer a {
    width: fit-content;
    text-underline-offset: 0.25em;
  }

  .footer-contact p,
  .footer-embassy p {
    color: color-mix(in srgb, var(--undyed) 72%, transparent);
    font-size: var(--text--1);
  }

  .footer-coordinates,
  .footer-legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--undyed) 16%, transparent);
  }

  .footer-coordinates {
    margin-top: var(--space-3);
    color: var(--undyed);
  }

  .footer-legal {
    align-items: center;
    color: color-mix(in srgb, var(--undyed) 65%, transparent);
  }

  .footer-credit {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    margin-left: auto;
  }

  .footer-credit span {
    white-space: nowrap;
  }

  .footer-credit img {
    width: clamp(6rem, 7vw, 7.25rem);
    height: auto;
    mix-blend-mode: screen;
    opacity: 0.82;
  }

  @media (max-width: 52rem) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer-identity {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 36rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }

    .footer-identity {
      grid-column: auto;
    }

    .footer-coordinates,
    .footer-legal {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-credit {
      align-self: flex-end;
    }
  }
</style>
