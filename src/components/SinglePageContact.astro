---
import { Mail, MapPin, Phone } from "@lucide/astro";
import TaisBand from "./TaisBand.astro";
import { site } from "../lib/content";

// Every public fact below renders from the governed record in src/data/site.yaml.
const { contact, embassy } = site;
const [phone, email, location] = contact.rows;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <header class="contact__heading">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contact-title">{contact.heading}</h2>
      <p>{contact.intro}</p>
    </header>

    <div class="contact__details" aria-label="Consulate contact details">
      <article>
        <Phone size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">{phone.label}</p>
        <a href={phone.href}>{phone.value}</a>
      </article>
      <article>
        <Mail size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">{email.label}</p>
        <a href={email.href}>{email.value}</a>
      </article>
      <article>
        <MapPin size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">{location.label}</p>
        <a href={location.href}>{location.value}</a>
        <p>{contact.visitNote}</p>
      </article>
    </div>

    <article class="jurisdiction">
      <p class="eyebrow">{contact.jurisdiction.eyebrow}</p>
      <h3>{contact.jurisdiction.heading}</h3>
      <p>{contact.jurisdiction.body}</p>
    </article>
  </div>

  <TaisBand
    pattern="morinda-stripe"
    colors={["ink", "morinda", "turmeric", "undyed"]}
    height={40}
  />

  <aside class="embassy" aria-labelledby="contact-embassy-title">
    <div class="container embassy__inner">
      <header>
        <p class="eyebrow">{embassy.eyebrow}</p>
        <h3 id="contact-embassy-title">{embassy.heading}</h3>
      </header>
      <div>
        <p>{embassy.body}</p>
        <div class="embassy__links">
          <a href={embassy.phone.href}>{embassy.phone.display}</a>
          <a href={embassy.email.href}>{embassy.email.display}</a>
        </div>
      </div>
    </div>
  </aside>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--undyed);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5) var(--space-7);
    padding-block: var(--space-7);
  }

  .contact__heading h2,
  .jurisdiction h3,
  .embassy h3 {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
  }

  .contact__heading h2 {
    font-size: var(--text-4);
    line-height: var(--line-heading);
  }

  .contact__heading > p:last-child {
    max-width: 30rem;
    color: color-mix(in srgb, var(--undyed) 76%, transparent);
  }

  .contact__heading .eyebrow,
  .contact__details .eyebrow,
  .embassy .eyebrow {
    color: var(--turmeric);
  }

  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
    border-left: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
  }

  .contact__details article {
    min-width: 0;
    padding: var(--space-4);
    border-right: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
  }

  .contact__details article:last-child {
    grid-column: 1 / -1;
  }

  .contact__details svg {
    margin-bottom: var(--space-3);
    color: var(--turmeric);
  }

  .contact__details p {
    margin: 0;
  }

  .contact__details a {
    display: block;
    width: fit-content;
    margin-top: var(--space-1);
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .contact__details article:nth-child(2) a {
    font-family: var(--font-body);
    font-size: var(--text--1);
    font-weight: 500;
  }

  .contact__details article:last-child > p:last-child {
    margin-top: var(--space-2);
    color: color-mix(in srgb, var(--undyed) 72%, transparent);
    font-size: var(--text--1);
  }

  .jurisdiction {
    grid-column: 2;
    padding: var(--space-4);
    border-left: 0.2rem solid var(--turmeric);
    background: var(--indigo);
  }

  .jurisdiction .eyebrow {
    color: var(--turmeric);
  }

  .jurisdiction h3,
  .embassy h3 {
    font-size: var(--text-2);
  }

  .jurisdiction > p:last-child,
  .embassy p {
    color: color-mix(in srgb, var(--undyed) 76%, transparent);
  }

  .embassy {
    background: var(--indigo);
  }

  .embassy__inner {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5) var(--space-7);
    padding-block: var(--space-6);
  }

  .embassy p {
    margin-top: 0;
  }

  .embassy__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .embassy__links a {
    color: var(--turmeric);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 52rem) {
    .contact__inner,
    .embassy__inner {
      grid-template-columns: 1fr;
    }

    .jurisdiction {
      grid-column: auto;
    }
  }

  @media (max-width: 36rem) {
    .contact__details {
      grid-template-columns: 1fr;
    }

    .contact__details article:last-child {
      grid-column: auto;
    }
  }
</style>
