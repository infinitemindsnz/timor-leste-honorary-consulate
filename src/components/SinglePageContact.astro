---
import { Mail, MapPin, Phone } from "@lucide/astro";
import TaisBand from "./TaisBand.astro";
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <header class="contact__heading">
      <p class="eyebrow">KONTAKTU / Contact</p>
      <h2 id="contact-title">Contact the Consulate</h2>
      <p>
        Contact the Honorary Consulate directly by mobile or email. Visits are
        available by appointment.
      </p>
    </header>

    <div class="contact__details" aria-label="Consulate contact details">
      <article>
        <Phone size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">Mobile</p>
        <a href="tel:+642102168888">+64 21 021 68888</a>
      </article>
      <article>
        <Mail size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">Email</p>
        <a href="mailto:dave.tlconsulhonorario@gmail.com">
          dave.tlconsulhonorario@gmail.com
        </a>
      </article>
      <article>
        <MapPin size={24} stroke-width={1.6} aria-hidden="true" />
        <p class="eyebrow">Location</p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=97+Great+South+Road+Epsom+Auckland+New+Zealand"
        >
          97 Great South Road, Epsom, Auckland, New Zealand
        </a>
        <p>Visits are by appointment.</p>
      </article>
    </div>

    <article class="jurisdiction">
      <p class="eyebrow">Jurisdiction</p>
      <h3>Auckland and the North Island</h3>
      <p>
        The Honorary Consulate covers Auckland and the North Island, north of
        Wellington.
      </p>
    </article>
  </div>

  <TaisBand
    pattern="morinda-stripe"
    colors={["ink", "morinda", "turmeric", "undyed"]}
    height={40}
  />

  <aside class="embassy" aria-labelledby="contact-embassy-title">
    <div class="container embassy__inner">
      <header>
        <p class="eyebrow">Wellington Embassy</p>
        <h3 id="contact-embassy-title">
          Visas, passports and official documents
        </h3>
      </header>
      <div>
        <p>
          These services are handled by the Embassy of Timor-Leste in
          Wellington, not by the Honorary Consulate.
        </p>
        <div class="embassy__links">
          <a href="tel:+6444711971">(04) 471 1971</a>
          <a href="mailto:embassy.timorleste.nz@gmail.com">
            embassy.timorleste.nz@gmail.com
          </a>
        </div>
      </div>
    </div>
  </aside>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--undyed);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5) var(--space-7);
    padding-block: var(--space-7);
  }

  .contact__heading h2,
  .jurisdiction h3,
  .embassy h3 {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
  }

  .contact__heading h2 {
    font-size: var(--text-4);
    line-height: var(--line-heading);
  }

  .contact__heading > p:last-child {
    max-width: 30rem;
    color: color-mix(in srgb, var(--undyed) 76%, transparent);
  }

  .contact__heading .eyebrow,
  .contact__details .eyebrow,
  .embassy .eyebrow {
    color: var(--turmeric);
  }

  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
    border-left: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
  }

  .contact__details article {
    min-width: 0;
    padding: var(--space-4);
    border-right: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--undyed) 22%, transparent);
  }

  .contact__details article:last-child {
    grid-column: 1 / -1;
  }

  .contact__details svg {
    margin-bottom: var(--space-3);
    color: var(--turmeric);
  }

  .contact__details p {
    margin: 0;
  }

  .contact__details a {
    display: block;
    width: fit-content;
    margin-top: var(--space-1);
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: var(--text-1);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .contact__details article:nth-child(2) a {
    font-family: var(--font-body);
    font-size: var(--text--1);
    font-weight: 500;
  }

  .contact__details article:last-child > p:last-child {
    margin-top: var(--space-2);
    color: color-mix(in srgb, var(--undyed) 72%, transparent);
    font-size: var(--text--1);
  }

  .jurisdiction {
    grid-column: 2;
    padding: var(--space-4);
    border-left: 0.2rem solid var(--turmeric);
    background: var(--indigo);
  }

  .jurisdiction .eyebrow {
    color: var(--turmeric);
  }

  .jurisdiction h3,
  .embassy h3 {
    font-size: var(--text-2);
  }

  .jurisdiction > p:last-child,
  .embassy p {
    color: color-mix(in srgb, var(--undyed) 76%, transparent);
  }

  .embassy {
    background: var(--indigo);
  }

  .embassy__inner {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5) var(--space-7);
    padding-block: var(--space-6);
  }

  .embassy p {
    margin-top: 0;
  }

  .embassy__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .embassy__links a {
    color: var(--turmeric);
    font-weight: 500;
    overflow-wrap: anywhere;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 52rem) {
    .contact__inner,
    .embassy__inner {
      grid-template-columns: 1fr;
    }

    .jurisdiction {
      grid-column: auto;
    }
  }

  @media (max-width: 36rem) {
    .contact__details {
      grid-template-columns: 1fr;
    }

    .contact__details article:last-child {
      grid-column: auto;
    }
  }
</style>
