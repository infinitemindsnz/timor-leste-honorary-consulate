# Resend — use a restricted production key and a verified sending domain.
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM_ADDRESS=Honorary Consulate of Timor-Leste <enquiries@consulatetimorleste.co.nz>
CONSULATE_RECIPIENT_EMAIL=consul@consulatetimorleste.co.nz

# Cloudflare Turnstile — use separate keys for local, preview and production.
PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=www.consulatetimorleste.co.nz

# TODO(client): confirm the response-time commitment before launch.
CONSULATE_RESPONSE_WINDOW=five working days
